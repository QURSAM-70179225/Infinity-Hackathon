# Copy this file to .env and fill in real values. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here
GROQ_API_KEY=your_groq_key_here
# Optional: force a specific Groq model. Leave empty to pick an available one automatically.
GROQ_MODEL=
# Optional backup provider, used only if Groq fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Long random text used to sign login tokens.
SESSION_SECRET=change_me_to_a_long_random_string
# Frontend URL allowed to call this API when deployed (comma separated). Empty = allow all.
CORS_ORIGIN=
# supabase = hosted database. local = JSON file on this computer (backend/data/db.json)
DB_MODE=supabase
PORT=5000
